{
    "name": "denprog/meridian",
    "description": "Simplify internationalization in your Laravel projects with Meridian. Easily manage countries, currencies, exchange rates, languages, and perform GeoIP lookups.",
    "keywords": [
        "php",
        "laravel",
        "package",
        "meridian",
        "countries",
        "currencies",
        "exchange-rates",
        "languages",
        "geoip",
        "internationalization",
        "i18n",
        "localization"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/denprog5/meridian",
    "authors": [
        {
            "name": "Denis Liakhar",
            "email": "denisprogressive@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/denprog5/meridian/issues",
        "source": "https://github.com/denprog5/meridian"
    },
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "geoip2/geoip2": "^3.0",
        "laravel/framework": "^11.0 || ^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-type-coverage": "^3.0 || ^4.0",
        "rector/rector": "^2.0",
        "symfony/var-dumper": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Denprog\\Meridian\\": "src/",
            "Denprog\\Meridian\\Database\\Factories\\": "database/factories/",
            "Denprog\\Meridian\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --ansi",
        "security:audit": "composer audit --locked --no-interaction",
        "test": "pest --colors=always",
        "test:coverage": "pest --colors=always --coverage --min=60",
        "refactor": "rector",
        "refactor:check": "rector --dry-run",
        "check": [
            "@lint:check",
            "@analyse",
            "@security:audit",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Denprog\\Meridian\\MeridianServiceProvider"
            ],
            "aliases": {
                "MeridianCountry": "Denprog\\Meridian\\Facades\\MeridianCountry",
                "MeridianCurrency": "Denprog\\Meridian\\Facades\\MeridianCurrency",
                "MeridianLanguage": "Denprog\\Meridian\\Facades\\MeridianLanguage",
                "MeridianGeoLocator": "Denprog\\Meridian\\Facades\\MeridianGeoLocator",
                "MeridianExchangeRate": "Denprog\\Meridian\\Facades\\MeridianExchangeRate",
                "MeridianUpdateExchangeRate": "Denprog\\Meridian\\Facades\\MeridianUpdateExchangeRate"
            }
        }
    }
}
